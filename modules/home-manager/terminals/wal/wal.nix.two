{ config, pkgs, lib, ... }:

let
  colors = builtins.fromJSON (builtins.readFile ./colors.json);
in
{
  programs.zsh.initExtra = ''
    printf '\033]10;${colors.special.foreground}\007'
    printf '\033]11;${colors.special.background}\007'
    ${lib.concatStringsSep "\n" (lib.imap0 (i: color: "printf '\\033]4;${toString i};${color}\\007'") colors.colors)}
'';
}
